<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- SIP Server -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/cfg_sip_server"
        android:textStyle="bold"
        android:textColor="@color/text_label" />

    <EditText
        android:id="@+id/etSipServer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="sip.callagent.pro"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint"
        android:background="@drawable/input_bg"
        android:padding="10dp"
        android:layout_marginTop="4dp"
        android:inputType="text"
        android:importantForAutofill="no" />

    <!-- SIP Port -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/cfg_sip_port"
        android:textStyle="bold"
        android:textColor="@color/text_label"
        android:layout_marginTop="12dp" />

    <EditText
        android:id="@+id/etSipPort"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="5060"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint"
        android:background="@drawable/input_bg"
        android:padding="10dp"
        android:layout_marginTop="4dp"
        android:inputType="number"
        android:importantForAutofill="no" />

    <!-- SIP Username -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/cfg_sip_username"
        android:textStyle="bold"
        android:textColor="@color/text_label"
        android:layout_marginTop="12dp" />

    <EditText
        android:id="@+id/etSipUser"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/cfg_hint_username"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint"
        android:background="@drawable/input_bg"
        android:padding="10dp"
        android:layout_marginTop="4dp"
        android:inputType="text"
        android:importantForAutofill="no" />

    <!-- SIP Password -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/cfg_sip_password"
        android:textStyle="bold"
        android:textColor="@color/text_label"
        android:layout_marginTop="12dp" />

    <EditText
        android:id="@+id/etSipPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/cfg_hint_password"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint"
        android:background="@drawable/input_bg"
        android:padding="10dp"
        android:layout_marginTop="4dp"
        android:inputType="textPassword"
        android:importantForAutofill="no" />

    <!-- Own number: the MSISDN of the SIM in this phone.  Sent as the SIP
         destination so the server can map the call to an assistant, the same
         way a Fritz!Box sends the DID that was dialled.  Use the format the
         server's number table stores (e.g. 015112345678). -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/cfg_own_number"
        android:textStyle="bold"
        android:textColor="@color/text_label"
        android:layout_marginTop="12dp" />

    <EditText
        android:id="@+id/etOwnNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/cfg_hint_own_number"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint"
        android:background="@drawable/input_bg"
        android:padding="10dp"
        android:layout_marginTop="4dp"
        android:inputType="phone"
        android:importantForAutofill="no" />

    <!-- Autoconnect -->
    <CheckBox
        android:id="@+id/cbAutoconnect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/cfg_autoconnect"
        android:textColor="@color/text_label"
        android:layout_marginTop="16dp"
        android:checked="true" />

</LinearLayout>
