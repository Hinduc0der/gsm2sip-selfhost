<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- ═══ Main tabbed layout ═══ -->
    <LinearLayout
        android:id="@+id/tabbedRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Tab content area (fills space above bottom bar) -->
        <FrameLayout
            android:id="@+id/tabContent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- ── TAB 0: Home (default view) ── -->
            <LinearLayout
                android:id="@+id/tabHome"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone"
                android:padding="14dp">

                <!-- Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_gateway_title"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/tvHomeStatusPill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/status_offline"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_secondary"
                        android:background="@drawable/input_bg"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:layout_marginStart="10dp" />

                    <!-- Height is pinned to the status pill's rather than wrapped:
                         with no text these still reserve a default line box,
                         which made them taller than the pill beside them. -->
                    <TextView
                        android:id="@+id/tvHomeTlsBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="33dp"
                        android:gravity="center"
                        android:contentDescription="@string/desc_tls_badge"
                        android:background="@drawable/input_bg"
                        android:drawableStart="@drawable/ic_shield_lock"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="0dp"
                        android:layout_marginStart="6dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvHomeSrtpBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="33dp"
                        android:gravity="center"
                        android:contentDescription="@string/desc_srtp_badge"
                        android:background="@drawable/input_bg"
                        android:drawableStart="@drawable/ic_fa_key"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="0dp"
                        android:layout_marginStart="6dp"
                        android:visibility="gone" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <!-- Переключатель языка интерфейса.  Смена языка идёт через
                         per-app locale API AppCompat (setApplicationLocales),
                         он сам пересоздаёт активити и подхватывает ресурсы.
                         Активная кнопка подсвечивается из кода. -->
                    <TextView
                        android:id="@+id/btnLangRu"
                        android:layout_width="wrap_content"
                        android:layout_height="33dp"
                        android:gravity="center"
                        android:text="@string/lang_ru"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_secondary"
                        android:background="@drawable/input_bg"
                        android:paddingHorizontal="9dp"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:id="@+id/btnLangEn"
                        android:layout_width="wrap_content"
                        android:layout_height="33dp"
                        android:gravity="center"
                        android:text="@string/lang_en"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_secondary"
                        android:background="@drawable/input_bg"
                        android:paddingHorizontal="9dp"
                        android:layout_marginEnd="6dp" />

                    <ImageButton
                        android:id="@+id/btnHomeMenu"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:src="@drawable/ic_gear"
                        android:background="@drawable/input_bg"
                        android:contentDescription="@string/desc_menu" />
                </LinearLayout>

                <!-- Link state: the two networks this gateway depends on.
                     Both legs matter — a call needs the modem for GSM and WiFi
                     for SIP/RTP — so both are shown together. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <TextView
                        android:id="@+id/tvNetMobile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="—"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:textColor="@color/text_secondary"
                        android:background="@drawable/input_bg"
                        android:padding="8dp"
                        android:layout_marginEnd="4dp"
                        android:singleLine="true"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tvNetWifi"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="—"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:textColor="@color/text_secondary"
                        android:background="@drawable/input_bg"
                        android:padding="8dp"
                        android:layout_marginStart="4dp"
                        android:singleLine="true"
                        android:ellipsize="end" />
                </LinearLayout>

                <!-- Filter chips -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="16dp">

                    <Button
                        android:id="@+id/btnFilterAll"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:text="@string/filter_all"
                        android:textSize="13sp"
                        android:textAllCaps="false"
                        android:textColor="#052E16"
                        android:backgroundTint="#34D399"
                        android:minWidth="76dp"
                        android:minHeight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btnFilterIncoming"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:text="@string/filter_incoming"
                        android:textSize="13sp"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:backgroundTint="@color/btn_secondary"
                        android:minWidth="76dp"
                        android:minHeight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btnFilterOutgoing"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:text="@string/filter_outgoing"
                        android:textSize="13sp"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:backgroundTint="@color/btn_secondary"
                        android:minWidth="76dp"
                        android:minHeight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />
                </LinearLayout>

                <!-- Everything below the chips scrolls; the header and the
                     filter chips stay put so they are reachable while reading
                     a long call list. -->
                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:fillViewport="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                    <!-- Active call -->
                    <LinearLayout
                        android:id="@+id/homeCallCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/card_bg"
                        android:padding="16dp"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/active_call"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="#34D399" />

                            <TextView
                                android:id="@+id/tvHomeCallDirection"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/dir_gsm_sip"
                                android:textSize="11sp"
                                android:textColor="@color/text_secondary"
                                android:background="@drawable/input_bg"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvHomeCallTimer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00:00"
                            android:textSize="44sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace"
                            android:textColor="@color/text_primary"
                            android:paddingTop="10dp" />

                        <TextView
                            android:id="@+id/tvHomeCallFrom"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:paddingTop="6dp" />

                        <TextView
                            android:id="@+id/tvHomeCallTo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textSize="14sp"
                            android:textColor="#60A5FA"
                            android:paddingTop="2dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingTop="16dp">

                            <!-- Icon over label: the label carries the state
                                 (Mute/Unmute, Snoop/Stop), the icon makes the
                                 three actions distinguishable at a glance. -->
                            <Button
                                android:id="@+id/btnHomeMute"
                                android:layout_width="0dp"
                                android:layout_height="62dp"
                                android:layout_weight="1"
                                android:text="@string/btn_mute"
                                android:textSize="11sp"
                                android:textColor="@color/text_primary"
                                android:backgroundTint="@color/btn_secondary"
                                android:drawableTop="@drawable/ic_fa_volume_xmark"
                                android:drawablePadding="2dp"
                                android:paddingTop="8dp"
                                android:paddingBottom="6dp"
                                android:layout_marginEnd="4dp"
                                android:minHeight="0dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp" />

                            <Button
                                android:id="@+id/btnHomeSnoop"
                                android:layout_width="0dp"
                                android:layout_height="62dp"
                                android:layout_weight="1"
                                android:text="@string/btn_snoop"
                                android:textSize="11sp"
                                android:textColor="@color/text_primary"
                                android:backgroundTint="@color/btn_secondary"
                                android:drawableTop="@drawable/ic_fa_headphones"
                                android:drawablePadding="2dp"
                                android:paddingTop="8dp"
                                android:paddingBottom="6dp"
                                android:layout_marginHorizontal="4dp"
                                android:minHeight="0dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp" />

                            <Button
                                android:id="@+id/btnHomeEnd"
                                android:layout_width="0dp"
                                android:layout_height="62dp"
                                android:layout_weight="1"
                                android:text="@string/btn_end"
                                android:textSize="11sp"
                                android:textColor="#FFFFFF"
                                android:backgroundTint="#B91C1C"
                                android:drawableTop="@drawable/ic_fa_phone_slash"
                                android:drawablePadding="2dp"
                                android:paddingTop="8dp"
                                android:paddingBottom="6dp"
                                android:layout_marginStart="4dp"
                                android:minHeight="0dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Recent calls -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="18dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/recent_calls"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_secondary" />

                        <TextView
                            android:id="@+id/tvHomeTrafficDay"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/traffic_today"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/homeTrafficList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/tvHomeTrafficEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/traffic_empty"
                        android:textSize="13sp"
                        android:textColor="@color/text_hint"
                        android:paddingVertical="14dp" />

                    <!-- Ненавязчивая добровольная ссылка доната (DonationAlerts) в самом низу
                         прокручиваемой части главного экрана. -->
                    <TextView
                        android:id="@+id/tvDonate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/donate_footer"
                        android:textSize="12sp"
                        android:textColor="@color/accent"
                        android:paddingTop="24dp"
                        android:paddingBottom="12dp" />
                    </LinearLayout>
                </ScrollView>

            </LinearLayout>

            <!-- ── Settings (full screen, replaces the old modal) ── -->
            <LinearLayout
                android:id="@+id/tabConfig"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp">

                    <ImageButton
                        android:id="@+id/btnConfigBack"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:src="@drawable/ic_arrow_back"
                        android:scaleType="centerInside"
                        android:background="@drawable/input_bg"
                        android:contentDescription="@string/desc_back" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_title"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:paddingStart="12dp" />

                    <!-- Live event log — SIP registration, calls, GSM and
                         network transitions.  The old settings screen showed
                         it inline; it has its own screen now, reached here. -->
                    <ImageButton
                        android:id="@+id/btnCfgLogs"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:src="@drawable/ic_logs"
                        android:scaleType="centerInside"
                        android:background="@drawable/input_bg"
                        android:contentDescription="@string/desc_logs" />
                </LinearLayout>

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:fillViewport="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingBottom="20dp">

                        <ImageView
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="14dp"
                            android:src="@mipmap/ic_launcher"
                            android:contentDescription="@string/desc_app_logo" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:text="@string/app_logo_label"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:paddingTop="8dp" />

                        <TextView
                            android:id="@+id/tvCfgVersion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:textSize="12sp"
                            android:textColor="@color/text_label"
                            android:paddingTop="2dp"
                            android:paddingBottom="14dp" />

                        <TextView style="@style/CfgLabel" android:text="@string/cfg_sip_server" />
                        <EditText android:id="@+id/etCfgServer" style="@style/CfgField"
                            android:hint="callagent.pro" android:inputType="textUri" />

                        <TextView style="@style/CfgLabel" android:text="@string/cfg_sip_port" />
                        <EditText android:id="@+id/etCfgPort" style="@style/CfgField"
                            android:hint="5060" android:inputType="number" />

                        <TextView style="@style/CfgLabel" android:text="@string/cfg_sip_username" />
                        <EditText android:id="@+id/etCfgUser" style="@style/CfgField"
                            android:hint="@string/cfg_hint_username" android:inputType="text" />

                        <TextView style="@style/CfgLabel" android:text="@string/cfg_sip_password" />
                        <EditText android:id="@+id/etCfgPass" style="@style/CfgField"
                            android:hint="@string/cfg_hint_password" android:inputType="textPassword" />

                        <TextView style="@style/CfgLabel" android:text="@string/cfg_own_number" />
                        <!-- One field per active SIM, built at runtime: the
                             slots a device has, and which of them hold a live
                             SIM, are only knowable on the device. -->
                        <LinearLayout
                            android:id="@+id/llCfgOwnNumbers"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/cfg_own_number_hint_text"
                            android:textSize="12sp"
                            android:textColor="@color/text_hint"
                            android:paddingTop="6dp" />

                        <TextView style="@style/CfgLabel" android:text="@string/cfg_audio_codec" />

                        <RadioGroup
                            android:id="@+id/rgCfgCodec"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="4dp">

                            <RadioButton
                                android:id="@+id/rbCodecG722"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/cfg_codec_g722"
                                android:buttonTint="@color/accent"
                                android:textColor="@color/text_label" />

                            <RadioButton
                                android:id="@+id/rbCodecBoth"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/cfg_codec_both"
                                android:buttonTint="@color/accent"
                                android:textColor="@color/text_label" />

                            <RadioButton
                                android:id="@+id/rbCodecG711"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/cfg_codec_g711"
                                android:buttonTint="@color/accent"
                                android:textColor="@color/text_label" />
                        </RadioGroup>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/cfg_codec_hint"
                            android:textSize="12sp"
                            android:textColor="@color/text_hint"
                            android:paddingTop="6dp" />

                        <TextView style="@style/CfgLabel" android:text="@string/cfg_agent_volume" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="4dp">

                            <SeekBar
                                android:id="@+id/sbCfgAgentVolume"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:max="6"
                                android:progress="3"
                                android:progressTint="@color/accent"
                                android:thumbTint="@color/accent" />

                            <TextView
                                android:id="@+id/tvCfgAgentVolume"
                                android:layout_width="44dp"
                                android:layout_height="wrap_content"
                                android:gravity="end"
                                android:text="0"
                                android:textStyle="bold"
                                android:textColor="@color/text_label"
                                android:paddingStart="8dp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/cfg_agent_volume_hint"
                            android:textSize="12sp"
                            android:textColor="@color/text_hint"
                            android:paddingTop="6dp" />

                        <TextView style="@style/CfgLabel" android:text="@string/cfg_battery_protection" />

                        <CheckBox
                            android:id="@+id/cbCfgBatteryProtection"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/cfg_battery_keep"
                            android:buttonTint="@color/accent"
                            android:textColor="@color/text_label"
                            android:layout_marginTop="4dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="4dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/cfg_battery_start"
                                android:textColor="@color/text_label" />

                            <EditText
                                android:id="@+id/etCfgBatteryStart"
                                android:layout_width="64dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:gravity="center"
                                android:inputType="number"
                                android:maxLength="3"
                                android:textColor="@color/text_primary"
                                android:background="@drawable/input_bg"
                                android:padding="8dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/cfg_battery_stop"
                                android:textColor="@color/text_label"
                                android:layout_marginStart="12dp" />

                            <EditText
                                android:id="@+id/etCfgBatteryStop"
                                android:layout_width="64dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:gravity="center"
                                android:inputType="number"
                                android:maxLength="3"
                                android:textColor="@color/text_primary"
                                android:background="@drawable/input_bg"
                                android:padding="8dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/cfg_percent"
                                android:textColor="@color/text_label"
                                android:layout_marginStart="4dp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvCfgBatteryStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/cfg_battery_status_disabled"
                            android:textSize="12sp"
                            android:textColor="@color/text_hint"
                            android:paddingTop="6dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/cfg_battery_hint"
                            android:textSize="12sp"
                            android:textColor="@color/text_hint"
                            android:paddingTop="4dp" />

                        <CheckBox
                            android:id="@+id/cbCfgAutoconnect"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/cfg_autoconnect"
                            android:buttonTint="@color/accent"
                            android:textColor="@color/text_label"
                            android:layout_marginTop="16dp" />

                        <CheckBox
                            android:id="@+id/cbCfgUseStun"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/cfg_use_stun"
                            android:buttonTint="@color/accent"
                            android:textColor="@color/text_label"
                            android:layout_marginTop="8dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/cfg_stun_hint"
                            android:textSize="12sp"
                            android:textColor="@color/text_hint"
                            android:paddingTop="6dp" />

                        <CheckBox
                            android:id="@+id/cbCfgTls"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/cfg_enable_tls"
                            android:buttonTint="@color/accent"
                            android:textColor="@color/text_label"
                            android:layout_marginTop="8dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/cfg_tls_hint"
                            android:textSize="12sp"
                            android:textColor="@color/text_hint"
                            android:paddingTop="6dp" />

                        <CheckBox
                            android:id="@+id/cbCfgSrtp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/cfg_encrypt_audio_srtp"
                            android:buttonTint="@color/accent"
                            android:textColor="@color/text_label"
                            android:layout_marginTop="8dp" />

                        <TextView
                            android:id="@+id/tvCfgSrtpHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/cfg_srtp_hint"
                            android:textSize="12sp"
                            android:textColor="@color/text_hint"
                            android:paddingTop="6dp" />

                        <CheckBox
                            android:id="@+id/cbCfgTranslit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/cfg_ascii_sms"
                            android:buttonTint="@color/accent"
                            android:textColor="@color/text_label"
                            android:layout_marginTop="8dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/cfg_ascii_hint"
                            android:textSize="12sp"
                            android:textColor="@color/text_hint"
                            android:paddingTop="6dp" />

                        <Button
                            android:id="@+id/btnCfgClearRecents"
                            android:layout_width="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_height="40dp"
                            android:text="@string/cfg_clear_recents"
                            android:textSize="12sp"
                            android:paddingStart="20dp"
                            android:paddingEnd="20dp"
                            android:textColor="#F87171"
                            android:backgroundTint="#374151"
                            android:layout_marginTop="24dp"
                            android:layout_marginBottom="20dp"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp" />

                        <Button
                            android:id="@+id/btnCfgSave"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:text="@string/cfg_save"
                            android:textStyle="bold"
                            android:textColor="@color/accent_on"
                            android:backgroundTint="@color/accent"
                            android:layout_marginTop="0dp"
                            android:minHeight="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp" />
                    </LinearLayout>
                </ScrollView>
            </LinearLayout>

            <!-- ── Logs (reached from the Settings header) ── -->
            <LinearLayout
                android:id="@+id/tabLogs"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:background="@color/background"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp">

                    <ImageButton
                        android:id="@+id/btnLogsBack"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:src="@drawable/ic_arrow_back"
                        android:scaleType="centerInside"
                        android:background="@drawable/input_bg"
                        android:contentDescription="@string/desc_back" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/logs_title"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:paddingStart="12dp" />

                    <ImageButton
                        android:id="@+id/btnLogsCopy"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:src="@drawable/ic_copy"
                        android:scaleType="centerInside"
                        android:background="@drawable/input_bg"
                        android:contentDescription="@string/desc_copy_log"
                        android:layout_marginEnd="8dp" />

                    <ImageButton
                        android:id="@+id/btnLogsClear"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:src="@drawable/ic_trash"
                        android:scaleType="centerInside"
                        android:background="@drawable/input_bg"
                        android:contentDescription="@string/desc_clear_log" />
                </LinearLayout>

                <ScrollView
                    android:id="@+id/svLog"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@color/surface"
                    android:padding="8dp"
                    android:layout_marginHorizontal="14dp"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:id="@+id/tvLog"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_log"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:textIsSelectable="true"
                        android:text="" />
                </ScrollView>
            </LinearLayout>


        </FrameLayout>

<!-- Bottom tab bar removed: navigation is the header menu on the home view -->
    </LinearLayout>

    <!-- ═══ Full-screen in-call overlay (above everything, hidden by default) ═══ -->
    <LinearLayout
        android:id="@+id/inCallView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/background"
        android:visibility="gone"
        android:gravity="center_horizontal">

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvInCallStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/incall_calling"
            android:textSize="16sp"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/tvInCallNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="32sp"
            android:textColor="@color/text_primary"
            android:fontFamily="monospace"
            android:gravity="center"
            android:paddingVertical="16dp"
            android:paddingHorizontal="24dp"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="18sp"
            android:autoSizeMaxTextSize="32sp" />

        <TextView
            android:id="@+id/tvInCallTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textSize="48sp"
            android:textColor="@color/text_primary"
            android:fontFamily="monospace"
            android:paddingVertical="24dp"
            android:visibility="gone" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Listen in on both sides through the speaker.  Does not touch the
             microphone, which stays muted for the whole call. -->
        <Button
            android:id="@+id/btnInCallMonitor"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginBottom="12dp"
            android:text="@string/incall_listen"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2563EB"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <Button
            android:id="@+id/btnInCallEnd"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginBottom="32dp"
            android:text="@string/incall_end_call"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#DC2626"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />
    </LinearLayout>

</FrameLayout>
