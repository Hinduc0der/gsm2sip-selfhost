    <string name="cfg_own_number_hint_text">Sent as the SIP destination so the server can map the call to an assistant. Without it the gateway addresses its own extension and the call loops back.</string>
    <string name="cfg_audio_codec">Audio Codec</string>
    <string name="cfg_codec_g722">G.722 only — wideband 16 kHz (recommended)</string>
    <string name="cfg_codec_both">G.722 preferred, G.711 allowed</string>
    <string name="cfg_codec_g711">G.711 only — narrowband 8 kHz</string>
    <string name="cfg_codec_hint">Offering G.711 alongside G.722 usually means the server picks G.711 and every call is narrowband, which is why G.722 alone is the default.</string>
    <string name="cfg_agent_volume">Agent Volume</string>
    <string name="cfg_agent_volume_hint">How loud the agent is to the GSM caller. 0 is what the detected device asks for; each step roughly a third louder or quieter. Raise it if callers say the agent is faint, lower it if the line distorts.</string>
    <string name="cfg_battery_protection">Battery charge protection</string>
    <string name="cfg_battery_keep">Keep the battery between these limits</string>
    <string name="cfg_battery_start">Start charging below</string>
    <string name="cfg_battery_stop" formatted="false">"%     Stop at"</string>
    <string name="cfg_percent" formatted="false">%</string>
    <string name="cfg_battery_status_disabled">Disabled</string>
    <string name="cfg_battery_hint" formatted="false">Requires the gsm2sip Magisk module. The default 35%–65% range reduces battery wear while the phone stays connected to USB.</string>
    <string name="cfg_autoconnect">Autoconnect on startup</string>
    <string name="cfg_use_stun">Use STUN</string>
    <string name="cfg_stun_hint">Finds the public IP so SIP and RTP survive NAT. Turn off for a SIP server on the local network.</string>
    <string name="cfg_enable_tls">Enable TLS</string>
    <string name="cfg_tls_hint">Encrypts SIP signalling — registration, calls and SMS text. Call audio (RTP) is not encrypted either way. The server must offer TLS, usually on port 5061.</string>
    <string name="cfg_encrypt_audio_srtp">Encrypt audio (SRTP)</string>
    <string name="cfg_srtp_hint">SDES-keyed SRTP (RFC 3711). Requires TLS: the keys travel inside the SIP signalling, so over plain UDP they would be readable by anyone on the path.</string>
    <string name="cfg_srtp_hint_on">SDES-keyed SRTP (RFC 3711). Audio is encrypted when the server agrees; if it answers without SRTP the call continues unencrypted and the log says so.</string>
    <string name="cfg_srtp_hint_off">Requires TLS. The keys travel inside the SIP signalling, so over plain UDP they would be readable by anyone on the path.</string>
    <string name="cfg_ascii_sms">ASCII-only outgoing SMS</string>
    <string name="cfg_ascii_hint">Rewrites accents before sending: für becomes fuer. Turn on if umlauts arrive mangled. Cyrillic, Hebrew, Arabic and other non-Latin text is never rewritten — it is sent as-is.</string>
